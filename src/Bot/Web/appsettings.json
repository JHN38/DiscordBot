{
  "Serilog": {
    "Using": [
      "Serilog.Expressions",
      "Serilog.Sinks.Console"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "theme": "Serilog.Sinks.SystemConsole.Themes.SystemConsoleTheme::Literate, Serilog.Sinks.Console"
        }
      }
    ],
    "Filter": [
      {
        "Name": "ByExcluding",
        "Args": {
          "expression": "RequestPath = '/health'"
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName"
    ]
  },
  "AllowedHosts": "*",
  "Bot": {
    "TextCommandPrefix": ">",
    "Token": "",
    "GuildId": "",
    "AdminIds": []
  },
  "Wolverine": {
    "RecordKeepingHost": "localhost",
    "WeatherHost": "localhost",
    "WebSearchHost": "localhost"
  }
}
